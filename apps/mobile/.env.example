EXPO_PUBLIC_API_URL=http://localhost:5000/api/v1
# NOTE: If you are testing on a physical device using Expo Go, localhost will not work!
# You should either:
# 1. Temporarily change this to your computer's local Wi-Fi IP address (e.g. EXPO_PUBLIC_API_URL=http://192.168.1.5:5000/api/v1)
# 2. Or leave it blank/commented out if you are relying on the dynamic IP fallback in src/api/client.ts
